<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net5.0;net6.0;net7.0;net8.0;net9.0;net10.0;netstandard2.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<PackageId>NeoIniLight</PackageId>
		<Version>1.0.4</Version>
		<Authors>Lonewolf239</Authors>
		<Description>Lightweight, thread-safe configuration framework for .NET with INI-like persistence, atomic writes, automatic backups, and source generators. Supports .NET 5+ and .NET Standard 2.0.</Description>
		<PackageTags>config;configuration;ini-serialization;lightweight;atomic-writes;backup;thread-safe;source-generator;dotnet-config</PackageTags>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/Lonewolf239/NeoIniLight</RepositoryUrl>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README-NUGET.md</PackageReadmeFile>
		<Copyright>Copyright © Lonewolf239 2026</Copyright>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EnablePackageValidation>true</EnablePackageValidation>
		<NuGetAudit>false</NuGetAudit>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<LangVersion>8.0</LangVersion>
		<DefineConstants>NETSTANDARD2_0</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="Generators\**" />
		<Content Remove="Generators\**" />
		<None Remove="Generators\**" />
		<EmbeddedResource Remove="Generators\**" />
		<Compile Remove="NeoIniDemo\**" />
		<Content Remove="NeoIniDemo\**" />
		<None Remove="NeoIniDemo\**" />
		<EmbeddedResource Remove="NeoIniDemo\**" />
		<Compile Remove="NeoIniLight.Tests\**" />
		<Content Remove="NeoIniLight.Tests\**" />
		<None Remove="NeoIniLight.Tests\**" />
		<EmbeddedResource Remove="NeoIniLight.Tests\**" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="Generators\NeoIni.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>
	<ItemGroup>
		<None Include="Generators\bin\$(Configuration)\netstandard2.0\NeoIni.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>
	<ItemGroup>
		<None Include="icon.png" Pack="true" PackagePath="\" />
		<None Include="docs\README-NUGET.md" Pack="true" PackagePath="\" />
		<None Include="LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="AsyncReaderWriterLock" Version="1.0.3" />
	</ItemGroup>
</Project>
